<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LiveCue" Width="1160" Height="800" MinWidth="900" MinHeight="650" Foreground="#132445" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
 <Window.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F8FCFF" Offset="0"/><GradientStop Color="#E4F0FF" Offset="1"/></LinearGradientBrush></Window.Background>
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="18,10"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#234675"/><Setter Property="BorderBrush" Value="#C9DDF5"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#1768ED"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="IsReadOnly" Value="True"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#132445"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#EFFFFFFF"/><Setter Property="BorderBrush" Value="#D7E7FA"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="22"/></Style>
 </Window.Resources>
 <ScrollViewer x:Name="Page" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <Grid Margin="24,18,24,14" MinHeight="740" Height="{Binding ActualHeight, ElementName=Page}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="230"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,20"><Image x:Name="BrandIcon" Width="40" Height="40" Margin="0,0,12,0"/><TextBlock Text="LiveCue" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text="YOUR IPHONE. YOUR PC. IN SYNC." Foreground="#647B9D" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
  <Grid Grid.Row="1" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center"><TextBlock x:Name="PhoneStatus" Text="iPhone not connected" FontWeight="SemiBold"/><TextBlock x:Name="Status" Text="Relay stopped" Foreground="#426EA8" FontSize="13" TextWrapping="Wrap" Margin="0,4,12,0"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="StartButton" Content="Start relay" Background="#1768ED" Foreground="White"/><Button x:Name="PauseButton" Content="Pause relay" IsEnabled="False"/><Button x:Name="ShowPairButton" Content="Pair iPhone" Margin="0"/></StackPanel>
  </Grid>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="Incoming transcript" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="TranscriptHint" Grid.Row="1" Text="Received from your iPhone" Foreground="#647B9D" Margin="0,8,0,22"/>
    <Border Grid.Row="2" Background="#EAF4FF" CornerRadius="12" Padding="20"><DockPanel><TextBlock DockPanel.Dock="Top" Text="FROM IPHONE" FontSize="11" FontWeight="SemiBold" Foreground="#1768ED" Margin="0,0,0,14"/><TextBox x:Name="Transcript" FontSize="22" Text="Your next question will appear here."/></DockPanel></Border>
   </Grid></Border>
   <Border Grid.Column="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="Assistant reply" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="ResponseTime" Grid.Row="1" Text="Processed on your PC with Codex" Foreground="#647B9D" Margin="0,8,0,22"/>
    <Border Grid.Row="2" Background="#EAF4FF" CornerRadius="12" Padding="20"><DockPanel><TextBlock DockPanel.Dock="Top" Text="ASSISTANT" FontSize="11" FontWeight="SemiBold" Foreground="#1768ED" Margin="0,0,0,14"/><TextBox x:Name="Reply" FontSize="22" Text="Start the relay, then tap Assist on your iPhone."/></DockPanel></Border>
   </Grid></Border>
  </Grid>
  <Border Grid.Row="3" Style="{StaticResource Card}" Padding="14" Margin="0,14,0,0"><Expander x:Name="PairingExpander" Header="Pairing &amp; connection" Foreground="#234675"><ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto"><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="White" CornerRadius="8" Padding="8"><Viewbox Width="200" Height="200"><Canvas x:Name="QRCanvas" Width="240" Height="240" Background="White"/></Viewbox></Border>
   <StackPanel Grid.Column="1" Margin="20,0,0,0"><TextBlock x:Name="QRHint" Text="Already paired? Nothing to do. Generate a QR only to pair a new device or replace your pairing." TextWrapping="Wrap" Margin="0,0,0,12"/><WrapPanel><Button x:Name="PairButton" Content="Generate pairing QR" IsEnabled="False"/><Button x:Name="HideQRButton" Content="Hide QR"/></WrapPanel><TextBlock Text="PC ADDRESS" FontSize="11" Foreground="#647B9D" Margin="0,14,0,4"/><TextBox x:Name="Endpoint" MaxHeight="45"/><TextBlock Text="Codex: gpt-5.6-sol / low reasoning" Foreground="#647B9D" FontSize="12" Margin="0,10,0,0"/></StackPanel>
  </Grid></ScrollViewer></Expander></Border>
  <Expander Grid.Row="4" Header="Activity details" Margin="4,12,0,0"><DockPanel Margin="0,8,0,0"><WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8"><Button x:Name="ClearButton" Content="Clear activity"/><Button x:Name="StopButton" Content="Stop relay" IsEnabled="False"/></WrapPanel><TextBox x:Name="Activity" Height="130" FontFamily="Consolas" FontSize="12" Background="#F5FAFF" Padding="10"/></DockPanel></Expander>
  <TextBlock Grid.Row="5" Text="Activity is kept in memory only. Closing LiveCue stops its relay. Keep pairing codes private." Foreground="#647B9D" FontSize="11" Margin="4,14,0,0" TextWrapping="Wrap"/>
 </Grid>
 </ScrollViewer>
</Window>
